<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acerte o Número</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 35px;
            border-radius: 20px;
            text-align: center;
            width: 320px;
            box-shadow: 0 10px 30px #0003;
        }

        h1 {
            color: #764ba2;
        }

        input {
            padding: 12px;
            width: 80%;
            border: 2px solid #ddd;
            border-radius: 8px;
            margin: 15px 0;
            font-size: 18px;
            text-align: center;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            background: #764ba2;
            color: white;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background: #56327c;
        }

        #mensagem {
            font-weight: bold;
            margin-top: 20px;
            color: #444;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>🎯 Acerte o Número!</h1>

        <p>Escolhi um número entre 1 e 100.</p>
        <p>Será que você consegue descobrir?</p>

        <input type="number" id="palpite"
        placeholder="Digite seu palpite">

        <br>

        <button onclick="verificar()">Tentar!</button>

        <p id="mensagem">Boa sorte!</p>

        <p>Tentativas: <span id="tentativas">0</span></p>

        <button onclick="reiniciar()">Recomeçar</button>

    </div>

    <script>

        let numeroSecreto = Math.floor(Math.random() * 100) + 1;

        let tentativas = 0;

        function verificar() {

            let palpite = Number(document.getElementById("palpite").value);

            let mensagem = document.getElementById("mensagem");

            if (palpite < 1 || palpite > 100 || !Number.isInteger(palpite)) {
                mensagem.innerText = "Digite um número válido de 1 a 100!";
                return;
            }

            tentativas++;

            document.getElementById("tentativas").innerText = tentativas;

            if (palpite === numeroSecreto) {

                mensagem.innerText = "🎉 PARABÉNS! Você acertou!";

            } else if (palpite < numeroSecreto) {

                mensagem.innerText = "Tente um número MAIOR!";

            } else {

                mensagem.innerText = "Tente um número MENOR!";

            }

            document.getElementById("palpite").value = "";

        }

        function reiniciar() {

            numeroSecreto = Math.floor(Math.random() * 100) + 1;

            tentativas = 0;

            document.getElementById("tentativas").innerText = 0;

            document.getElementById("mensagem").innerText = "Novo jogo! Boa sorte!";

            document.getElementById("palpite").value = "";

        }

    </script>

</body>
</html